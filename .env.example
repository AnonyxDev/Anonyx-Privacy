# Browser-visible wallet configuration. Never put an AI key in NEXT_PUBLIC_*.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only AI gateway. Leave disabled until provider billing limits and
# the account allowlist are configured. Set hosted values as Site secrets.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_ALLOWED_USER_IDS=
# OpenAI-compatible HTTPS endpoint; the browser cannot override it.
AI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_NAME=OpenAI
